# lint: loaded-by dmg.eigs -- module fragment: dmg.eigs loads src/ + lib/ui.eigs before this file runs
# Debugger chrome (#53, fleet UI ladder rung 5 slice 3, first artifact) —
# a dock workspace around the LCD: center = the live LCD surface, west =
# registers panel + pause/step controls.
#
# The chrome is a PURE READER of the emulator: RUN drives the same
# run_frame the plain gfx mode uses (full hot-loop speed), STEP drives
# debug_step_instr (src/debug.eigs), and the registers panel text IS
# debug_regs_text — the same formatter the --dump-state oracle prints.
# What makes that non-vacuous is the render-decode oracle
# (tests/ui_debug_oracle.py): it reads the panel back OUT OF THE PIXELS
# and diffs against the core's stdout dump, so a render fault (dropped
# line, wrong glyph, stale text) fails the diff even though both sides
# share the formatter. Every pause/step emits the dump + panel geometry
# on stdout — that is the harness seam, not debug spam.
#
# Conventions (the liferaft visualizer / eigen-edit shape): loaded after
# src/*.eigs and lib/ui.eigs; `debugger_run` is defined but never called
# at load time; all mutable chrome state lives in the DBG dict (field
# writes cross the module boundary, bare rebinds do not — EigenScript#373).

# Initial memory-panel window: top of WRAM around the stack — live,
# nonzero bytes (an all-zero window would let a stuck-at-zero renderer
# pass the decode oracle). Also the planted mem fault's target byte.
DBG_MEM_HOME is 0xDF40

DBG is {
    "cpu": null,
    "mem": null,
    "ppu": null,
    "joy": null,
    "scale": 2,
    "paused": 0,
    "total": 0,
    "break_cycle": -1,
    "broke": 0,
    "geom_printed": 0,
    "dk": null,
    "tick_count": 0,
    "tick_limit": 0,
    "regs_cv": null,
    "mem_hv": null,
    "dis_il": null,
    "dis_addrs": [],
    "dis_n": 8,
    "bps": [],
    "tiles_cv": null,
    "tiles_fb": null,
    "oam_cv": null,
    "emit_tiles": 0,
    "btn_pause": null,
    "btn_step": null,
    "btn_frame": null,
    # --plant-render-fault (oracle validation only): corrupt the PANEL
    # text while the stdout dump stays truthful — the render-decode
    # checker MUST catch the divergence or it proves nothing.
    "plant_fault": 0,
    # --plant-mem-fault: corrupt one byte in the memory panel's RENDER
    # reader while the DBG_MEM seam (mem_read direct) stays truthful.
    "plant_mem": 0,
    # --plant-dis-fault: corrupt one WIDGET item while the DBG_DIS seam
    # (regenerated fresh at emit) stays truthful.
    "plant_dis": 0,
    # --plant-tiles-fault: invert tile 0's pixels in the RENDER fb only.
    "plant_tiles": 0,
    # --plant-oam-fault: corrupt the OAM panel's first WIDGET line only.
    "plant_oam": 0
}

# ---- Tile viewer: 384 tiles from VRAM 0x8000-0x97FF, 2bpp decoded
# into a 128x192 palette-indexed fb (16 tiles per row), blitted with
# gfx_fb like the LCD. Raw color indices, not BGP-mapped — this is a
# VRAM view, not a screen view. Rebuilt on pause/step only.
define _dbg_tiles_rebuild() as:
    local fb is DBG.tiles_fb
    unobserved:
      for t in range of 384:
        local base is 0x8000 + (t * 16)
        local tx is (t % 16) * 8
        local ty is (floor of (t / 16)) * 8
        for row in range of 8:
            local lo is mem_read of [DBG.mem, base + (row * 2)]
            local hi is mem_read of [DBG.mem, base + (row * 2) + 1]
            if DBG.plant_tiles == 1 and t == 0:
                lo is lo ^ 0xFF
                hi is hi ^ 0xFF
            local o is ((ty + row) * 128) + tx
            for bit in range of 8:
                local sh is 7 - bit
                fb[o + bit] is ((lo >> sh) & 1) | (((hi >> sh) & 1) << 1)

define _tiles_paint(cv, ax, ay) as:
    gfx_clip of [ax, ay, cv.w, cv.h]
    gfx_rect of [ax, ay, cv.w, cv.h, 8, 8, 12]
    local ox is ax + (floor of ((cv.w - 128) / 2))
    if ox < ax:
        ox is ax
    gfx_fb of [DBG.tiles_fb, 128, 192, ox, ay + 2, 1]
    gfx_clip of null

# ---- OAM panel: 40 sprites, 4 bytes each, as text (code_view). ----
define _dbg_oam_text() as:
    local lines is []
    for s in range of 40:
        local b is 0xFE00 + (s * 4)
        local sy is mem_read of [DBG.mem, b]
        local sx is mem_read of [DBG.mem, b + 1]
        local st is mem_read of [DBG.mem, b + 2]
        local sf is mem_read of [DBG.mem, b + 3]
        append of [lines, f"{hex of [s, 2]}: Y={hex of [sy, 2]} X={hex of [sx, 2]} T={hex of [st, 2]} F={hex of [sf, 2]}"]
    return join of [lines, "\n"]

define _dbg_dis_reader(a) as:
    return mem_read of [DBG.mem, a]

define _dbg_bp_hit(pc) as:
    for a in DBG.bps:
        if a == pc:
            return 1
    return 0

# The disassembly window as (addr, text) lines: forward from PC, "> "
# on the PC line, "* " on breakpoint lines. Both the widget refresh and
# the DBG_DIS emit call this — the emit calls it FRESH, so a fault
# planted into the widget's copy diverges the two.
define _dbg_dis_lines() as:
    local win is disasm_window of [_dbg_dis_reader, DBG.cpu.pc, DBG.dis_n]
    local out is []
    for i in range of (len of win):
        local ln is win[i]
        local mk is "  "
        if ln.addr == DBG.cpu.pc:
            mk is "> "
        elif (_dbg_bp_hit of ln.addr) == 1:
            mk is "* "
        append of [out, {"addr": ln.addr, "text": f"{mk}{ln.text}"}]
    return out

define _dbg_refresh_dis() as:
    local lines is _dbg_dis_lines of null
    local items is []
    local addrs is []
    for i in range of (len of lines):
        append of [items, lines[i].text]
        append of [addrs, lines[i].addr]
    if DBG.plant_dis == 1 and (len of items) > 1:
        items[1] is "  DEAD  NOP"
    DBG.dis_il.items is items
    DBG.dis_addrs is addrs
    DBG.dis_il.selected is 0 - 1

# The memory panel's reader — the RENDER leg. The DBG_MEM/DBG_SELECT
# seams deliberately bypass it and call mem_read directly (the CORE
# leg), so a fault planted here diverges the two and must be caught.
define _dbg_mem_reader(addr) as:
    local b is mem_read of [DBG.mem, addr]
    if DBG.plant_mem == 1 and addr == DBG_MEM_HOME:
        return b ^ 0x40
    return b

define _dbg_refresh_regs() as:
    local t is debug_regs_text of [DBG.cpu, DBG.mem, DBG.total]
    if DBG.plant_fault == 1:
        # Drop the first line and stamp a wrong PC — a render fault the
        # dump does not share.
        local nl is index_of of [t, "\n"]
        t is f"PC=DEAD\n{substr of [t, nl + 1, len of t]}"
    DBG.regs_cv.text is t
    if DBG.dis_il != null:
        _dbg_refresh_dis of null
    if DBG.oam_cv != null:
        local ot is _dbg_oam_text of null
        if DBG.plant_oam == 1:
            local onl is index_of of [ot, "\n"]
            ot is f"XX: DEAD\n{substr of [ot, onl + 1, len of ot]}"
        DBG.oam_cv.text is ot

define _dbg_render_fb() as:
    ppu_render_frame of [DBG.mem.data, DBG.ppu.fb]

# Pause/step acceptance seam: geometry + the canonical dump on stdout.
# The memory window rows mirror the hex_view render's whole-row
# selection through the shared hex_view_metrics seam, but read the bus
# via mem_read DIRECTLY — the render goes through _dbg_mem_reader, so
# the two legs are independent (that independence is what the planted
# mem fault validates).
define _dbg_emit_mem(mv) as:
    local m is hex_view_metrics of mv
    print of f"DBG_MEMGEOM {m.gutter} {m.cell_w} {m.half_gap} {m.cw} {m.row_h}"
    local r0 is floor of (mv.scroll_y / m.row_h)
    if r0 < 0:
        r0 is 0
    local rn is r0 + (ceil of (mv.h / m.row_h)) + 1
    local nrows is ceil of (mv.size / m.bpr)
    if rn > nrows:
        rn is nrows
    for ri in range of [r0, rn]:
        local dy is 2 + (ri * m.row_h) - mv.scroll_y
        if dy < 1:
            continue
        if dy + m.row_h > mv.h - 1:
            continue
        local addr0 is ri * m.bpr
        local hx is ""
        for ci in range of m.bpr:
            local a is addr0 + ci
            if a < mv.size:
                hx is hx + (hex of [mem_read of [DBG.mem, a], 2])
        print of f"DBG_MEM {dy} {hex of [addr0, 4]} {hx}"

define _dbg_emit_state(reason) as:
    local dkv is dock_view of DBG.dk
    local rb is dkv.panels.west[0].body
    print of f"=== DBG PAUSE ({reason}) ==="
    print of f"DBG_GEOM regs {rb[0]} {rb[1]} {rb[2]} {rb[3]}"
    if DBG.mem_hv != null:
        local mb is dkv.panels.south[0].body
        print of f"DBG_GEOM mem {mb[0]} {mb[1]} {mb[2]} {mb[3]}"
        _dbg_emit_mem of DBG.mem_hv
    if DBG.dis_il != null:
        local db is dkv.panels.east[0].body
        print of f"DBG_GEOM dis {db[0]} {db[1]} {db[2]} {db[3]}"
        local dls is _dbg_dis_lines of null
        for i in range of (len of dls):
            print of f"DBG_DIS {i} {dls[i].text}"
    if DBG.tiles_cv != null:
        _dbg_tiles_rebuild of null
        local tb is dkv.panels.east[1].body
        print of f"DBG_GEOM tiles {tb[0]} {tb[1]} {tb[2]} {tb[3]}"
        if DBG.emit_tiles == 1:
            for t in range of 384:
                local thx is ""
                for bi in range of 16:
                    thx is thx + (hex of [mem_read of [DBG.mem, 0x8000 + (t * 16) + bi], 2])
                print of f"DBG_TILEDATA {t} {thx}"
    if DBG.oam_cv != null:
        local ob is dkv.panels.south[1].body
        print of f"DBG_GEOM oam {ob[0]} {ob[1]} {ob[2]} {ob[3]}"
        local oam_lines is split of [_dbg_oam_text of null, "\n"]
        for oi in range of (len of oam_lines):
            print of f"DBG_OAM {oi} {oam_lines[oi]}"
    print of "=== STATE DUMP ==="
    print of (debug_state_dump of [DBG.cpu, DBG.mem, DBG.total])
    print of "=== END DUMP ==="

# USER clicks only (the #842 gesture contract). Core leg: mem_read.
define _dbg_mem_select(hv, addr) as:
    print of f"DBG_SELECT {hex of [addr, 4]} {hex of [mem_read of [DBG.mem, addr], 2]}"

# Click a disassembly line: toggle a breakpoint at its address.
define _dbg_dis_select(il) as:
    _dbg_blur of null
    local idx is il.selected
    if idx < 0 or idx >= (len of DBG.dis_addrs):
        return null
    local addr is DBG.dis_addrs[idx]
    if (_dbg_bp_hit of addr) == 1:
        local kept is []
        for a in DBG.bps:
            if a != addr:
                append of [kept, a]
        DBG.bps is kept
        print of f"DBG_BP {hex of [addr, 4]} 0"
    else:
        append of [DBG.bps, addr]
        print of f"DBG_BP {hex of [addr, 4]} 1"
    _dbg_refresh_dis of null

# A clicked button keeps toolkit focus, and the focus path re-fires a
# focused button on space/return ON TOP of our key handler (app_loop
# runs both). Emulator keys must stay emulator keys — drop focus after
# every control action (the push_modal focus-reset pattern).
define _dbg_blur() as:
    _ui.focused_widget is null
    _ui.focused_input is null
    _ui.focus_index is 0 - 1

define _dbg_pause_with(reason) as:
    DBG.paused is 1
    DBG.btn_pause.label is "Run [p]"
    _dbg_refresh_regs of null
    _dbg_emit_state of reason

define _dbg_set_paused(v) as:
    if v == 1:
        _dbg_pause_with of "paused"
    else:
        DBG.paused is 0
        DBG.btn_pause.label is "Pause [p]"

define _dbg_click_pause(b) as:
    _dbg_blur of null
    if DBG.paused == 1:
        _dbg_set_paused of 0
    else:
        _dbg_set_paused of 1

define _dbg_step_instr() as:
    DBG.total += debug_step_instr of [DBG.cpu, DBG.mem]
    _dbg_render_fb of null
    _dbg_refresh_regs of null
    _dbg_emit_state of "step"

define _dbg_step_frame() as:
    DBG.total += run_frame of [DBG.cpu, DBG.mem]
    _dbg_render_fb of null
    _dbg_refresh_regs of null
    _dbg_emit_state of "frame"

define _dbg_click_step(b) as:
    _dbg_blur of null
    if DBG.paused == 1:
        _dbg_step_instr of null

define _dbg_click_frame(b) as:
    _dbg_blur of null
    if DBG.paused == 1:
        _dbg_step_frame of null

define _lcd_paint(cv, ax, ay) as:
    local s is DBG.scale
    gfx_clip of [ax, ay, cv.w, cv.h]
    gfx_rect of [ax, ay, cv.w, cv.h, 8, 8, 12]
    local ox is ax + (floor of ((cv.w - (160 * s)) / 2))
    local oy is ay + (floor of ((cv.h - (144 * s)) / 2))
    if ox < ax:
        ox is ax
    if oy < ay:
        oy is ay
    gfx_fb of [DBG.ppu.fb, 160, 144, ox, oy, s]
    gfx_clip of null

define _dbg_tick(root) as:
    # Bounded run for the headless smoke (--gfx-frames): ticks, not
    # emulated frames, so it also terminates while paused.
    DBG.tick_count += 1
    if DBG.tick_limit > 0 and DBG.tick_count > DBG.tick_limit:
        request_quit of null
        return null
    if DBG.paused == 0:
        if (len of DBG.bps) > 0:
            # Breakpoints armed: run the frame through the debug
            # stepper so PC is visible at every instruction boundary.
            # Slower than run_frame — that is the price of arming bps;
            # disarm them all and RUN is the hot loop again.
            local fc is 0
            local hit is 0
            unobserved:
              loop while fc < CYCLES_PER_FRAME:
                fc += debug_step_instr of [DBG.cpu, DBG.mem]
                if (_dbg_bp_hit of DBG.cpu.pc) == 1:
                    hit is 1
                    break
            DBG.total += fc
            DBG.ppu.frame_count += 1
            _dbg_render_fb of null
            if hit == 1:
                _dbg_pause_with of "breakpoint"
                return null
        else:
            DBG.total += run_frame of [DBG.cpu, DBG.mem]
            DBG.ppu.frame_count += 1
            _dbg_render_fb of null
        _dbg_refresh_regs of null
        if DBG.break_cycle >= 0 and DBG.broke == 0 and DBG.total >= DBG.break_cycle:
            DBG.broke is 1
            _dbg_set_paused of 1
    # One-shot geometry report for the mouse oracle, after the first
    # layout pass has stamped absolute positions.
    if DBG.geom_printed == 0 and DBG.btn_pause._ax != null:
        DBG.geom_printed is 1
        # Size the disasm window to the whole rows its panel can show
        # (partial rows are clipped mid-glyph — the decode oracle reads
        # only what a user can actually read).
        local dkv is dock_view of DBG.dk
        local dbh is dkv.panels.east[0].body[3]
        DBG.dis_n is floor of ((dbh - 20) / 22)
        if DBG.dis_n < 4:
            DBG.dis_n is 4
        local bp is DBG.btn_pause
        local bs is DBG.btn_step
        local bf is DBG.btn_frame
        print of f"DBG_GEOM btn_pause {bp._ax} {bp._ay} {bp.w} {bp.h}"
        print of f"DBG_GEOM btn_step {bs._ax} {bs._ay} {bs.w} {bs.h}"
        print of f"DBG_GEOM btn_frame {bf._ax} {bf._ay} {bf.w} {bf.h}"

define _dbg_on_key(ev) as:
    if ev.type == "keydown":
        if ev.key == "escape":
            return 0
        if ev.key == "p":
            _dbg_click_pause of null
            return 1
        if ev.key == "s" and DBG.paused == 1:
            _dbg_step_instr of null
            return 1
        if ev.key == "f" and DBG.paused == 1:
            _dbg_step_frame of null
            return 1
        joypad_update of [DBG.joy, DBG.mem, ev]
        return 1
    if ev.type == "keyup":
        joypad_update of [DBG.joy, DBG.mem, ev]
    return 1

define debugger_run(cpu, mem, ppu, joy, scale, break_cycle, tick_limit, preset_bps) as:
    DBG.cpu is cpu
    DBG.mem is mem
    DBG.ppu is ppu
    DBG.joy is joy
    DBG.scale is scale
    DBG.break_cycle is break_cycle
    DBG.tick_limit is tick_limit

    local west_w is 210
    # Wide enough for the longest disasm line (21 chars at 12px + 16px
    # padding — the decode oracle caught a clipped final char at 260).
    local east_w is 280
    local south_h is 200
    local win_w is west_w + 5 + (160 * scale) + 24 + east_w + 5
    local win_h is (144 * scale) + 24
    if win_h < 460:
        win_h is 460
    # South band rides below the band the LCD + west stack need.
    win_h is win_h + south_h + 5

    local dk is dock of ["dock", 0, 0, win_w, win_h]
    dk.west_w is west_w
    dk.east_w is east_w
    dk.south_h is south_h
    DBG.dk is dk

    local lcd is canvas of ["lcd", 0, 0, 10, 10, _lcd_paint, null]
    dock_set_center of [dk, lcd]

    local regs_cv is code_view of ["regs", 0, 0, 10, 10, ""]
    regs_cv.line_numbers is 0
    DBG.regs_cv is regs_cv
    dock_add of [dk, "west", dock_panel of ["registers", regs_cv]]

    local controls is vbox of ["controls", 0, 0, 10, 10]
    controls.padding is 8
    controls.gap is 6
    local btn_pause is button of ["btn_pause", 0, 0, 180, 28, "Pause [p]", _dbg_click_pause]
    local btn_step is button of ["btn_step", 0, 0, 180, 28, "Step instr [s]", _dbg_click_step]
    local btn_frame is button of ["btn_frame", 0, 0, 180, 28, "Step frame [f]", _dbg_click_frame]
    DBG.btn_pause is btn_pause
    DBG.btn_step is btn_step
    DBG.btn_frame is btn_frame
    append of [controls.children, btn_pause]
    append of [controls.children, btn_step]
    append of [controls.children, btn_frame]
    dock_add of [dk, "west", dock_panel of ["controls", controls]]

    # Memory panel (south): hex_view over the live bus, whole 64K
    # address space, opened at DBG_MEM_HOME. Pure reader; never copies
    # the memory.
    local mem_hv is hex_view of ["mem", 0, 0, 10, 10, _dbg_mem_reader, 0x10000]
    local mm is hex_view_metrics of mem_hv
    mem_hv.scroll_y is (floor of (DBG_MEM_HOME / mem_hv.bytes_per_row)) * mm.row_h
    mem_hv.on_select is _dbg_mem_select
    DBG.mem_hv is mem_hv
    dock_add of [dk, "south", dock_panel of ["memory", mem_hv]]

    # Disassembly panel (east): forward window from PC, click a line to
    # toggle a breakpoint there.
    local dis_il is item_list of ["dis", 0, 0, 10, 10, [], _dbg_dis_select]
    DBG.dis_il is dis_il
    dock_add of [dk, "east", dock_panel of ["disassembly", dis_il]]
    for preset in preset_bps:
        append of [DBG.bps, preset]

    # Tile viewer (east, under the disassembly).
    local tiles_cv is canvas of ["tiles", 0, 0, 10, 10, _tiles_paint, null]
    DBG.tiles_cv is tiles_cv
    DBG.tiles_fb is buffer of 24576
    dock_add of [dk, "east", dock_panel of ["tiles", tiles_cv]]

    # OAM panel (south, beside the memory panel).
    local oam_cv is code_view of ["oam", 0, 0, 10, 10, ""]
    oam_cv.line_numbers is 0
    DBG.oam_cv is oam_cv
    dock_add of [dk, "south", dock_panel of ["oam", oam_cv]]

    _dbg_render_fb of null
    _dbg_tiles_rebuild of null
    _dbg_refresh_regs of null

    gfx_open of [win_w, win_h, "DMG debugger"]
    print of f"Debugger chrome: {win_w}x{win_h} (scale {scale})"
    app_loop of [dk, _dbg_on_key, _dbg_tick]
    gfx_close of null
    return DBG.total
