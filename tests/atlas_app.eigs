# Atlas app (#53): renders the printable charset through code_view at
# the debugger registers panel's exact grid (scale-1 glyphs, 6px
# advance, 18px line pitch, text origin ax+4/ay+2) so ui_debug_oracle.py
# builds its glyph atlas from real rendered pixels — never a
# self-authored golden image. The oracle screenshots this window and
# cuts cells; the window stays open until the harness kills it.
load_file of "lib/ui.eigs"

line1 is ""
i is 33
loop while i < 80:
    line1 is line1 + (chr of i)
    i += 1
line2 is ""
loop while i < 127:
    line2 is line2 + (chr of i)
    i += 1

# Two glyph scales, both from real rendered output: code_view draws at
# scale 1 (registers/memory panels' grid), item_list at _theme.font_scale
# = 2 (the disassembly panel). vbox with gap 6: code_view rows at
# (4, 2 + li*18) from (0,0); item_list rows at (8, 50 + 4 + i*22).
cv is code_view of ["atlas1", 0, 0, 640, 44, f"{line1}\n{line2}"]
cv.line_numbers is 0
il is item_list of ["atlas2", 0, 0, 640, 60, [line1, line2], null]
root is vbox of ["root", 0, 0, 640, 200]
root.gap is 6
append of [root.children, cv]
append of [root.children, il]
gfx_open of [640, 200, "DMG atlas"]
app_loop of [root, null, null]
gfx_close of null
