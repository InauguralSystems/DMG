# Probe (#53): does the running binary's lib carry the widgets the
# debugger chrome needs (dock, #848)? On a pre-#848 pin `dock of` is an
# undefined variable -> nonzero exit; run_debug_ui_oracle.sh SKIPs then.
# Headless-safe: lib/ui.eigs is import-side-effect-free (gfx builtins
# only error at call time), the liferaft probe_timeline pattern.
load_file of "lib/ui.eigs"
d is dock of ["d", 0, 0, 100, 100]
p is dock_add of [d, "west", dock_panel of ["t", label of ["l", 0, 0, "x"]]]
v is dock_view of d
assert of [v != null, "dock_view returned null"]
print of "debug-ui probe ok"
